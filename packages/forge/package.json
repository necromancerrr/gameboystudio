{
  "name": "@gameboystudio/forge",
  "version": "0.1.0",
  "private": true,
  "description": "Ask for a game, play it, ask again. Internal — not shipped to creators.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge": "./bin/forge.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@gameboystudio/sdk": "file:../sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "default": "./dist/read.js"
    }
  }
}

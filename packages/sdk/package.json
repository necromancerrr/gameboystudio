{
  "name": "@gameboystudio/sdk",
  "version": "1.0.0",
  "description": "Build a game GameBoyStudio can host.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": "./dist/preview.js",
    "./toolbox": {
      "types": "./dist/toolbox/index.d.ts",
      "default": "./dist/toolbox/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "bin": {
    "gbs": "./bin/gbs.mjs"
  },
  "files": [
    "dist",
    "bin",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  }
}

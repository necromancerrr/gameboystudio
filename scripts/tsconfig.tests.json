{
  "//": "Used by scripts/verify-input.mjs and scripts/verify-net.mjs, to emit the input, networking and hosted-manifest layers as CommonJS that Node can require. The app's real typecheck is still `npm run build`.",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "rootDir": "../src",
    "outDir": "../.test-build"
  },
  "include": ["../src/input/**/*.ts", "../src/net/**/*.ts", "../src/hosted/manifest.ts", "../src/hosted/hostedConfig.ts", "../src/catalog/types.ts", "../src/emulation/core/types.ts"]
}

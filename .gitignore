# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# ...and any nested ones, e.g. packages/sdk and the proof project
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preview contact sheets (review artifacts)
/.preview-sheets/

# native runtime harness build output
/.native-build/

# input and networking harness build output
/.test-build/

# Hosted game artifacts and the manifest are build output, produced by
# `npm run hosted:build`. Committing them would also mean committing a manifest
# pointing at whatever origin it was last built for, which is how a localhost
# URL ends up in production.
/hosted-origin/public/games/
/hosted-origin/public/manifest.json

# SDK tarballs, produced by `npm run sdk:pack`
/dist-sdk/
/packages/sdk/dist/

# The proof game's own build output. It is a record, not a buildable part of
# this project — see proof/README.md.
/proof/**/node_modules/
/proof/**/.gbs/

# wrangler's local state for the room relay
/worker/.wrangler/
/hosted-origin/.wrangler/
/.wrangler/

# browser verification screenshots (review artifacts)
/.browser-shots/

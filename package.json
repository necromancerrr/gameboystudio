{
  "name": "gameboystudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "hosted:build": "node hosted-games/build.mjs",
    "hosted:deploy": "wrangler deploy --config hosted-origin/wrangler.toml",
    "hosted:dev": "wrangler dev --config hosted-origin/wrangler.toml --port 8788",
    "lint": "eslint",
    "measure:latency": "node scripts/measure-room-latency.mjs",
    "prebuild": "npm run sdk:build",
    "relay:deploy": "wrangler deploy --config worker/wrangler.toml",
    "relay:dev": "wrangler dev --config worker/wrangler.toml --port 8787 --var ALLOWED_ORIGINS:",
    "sdk:build": "tsc -p packages/sdk/tsconfig.json",
    "sdk:pack": "cd packages/sdk && npm pack --pack-destination ../../dist-sdk",
    "start": "next start",
    "verify": "npm run lint && npm run verify:worker && npm run verify:hosted-origin && npm run verify:catalog && npm run verify:native && npm run verify:input && npm run verify:net && npm run verify:hosted && npm run verify:sdk && npm run verify:frame && npm run build && npm run verify:bundles && npm run verify:browser",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:frame": "node scripts/verify-frame.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "verify:hosted-cache": "node scripts/verify-hosted-cache.mjs",
    "verify:hosted-origin": "tsc --noEmit -p hosted-origin/tsconfig.json",
    "verify:input": "node scripts/verify-input.mjs",
    "verify:native": "node scripts/verify-native-runtime.mjs",
    "verify:net": "node scripts/verify-net.mjs",
    "verify:relay": "node scripts/verify-relay-origins.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "verify:worker": "tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "next": "16.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@gameboystudio/sdk": "file:packages/sdk"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
